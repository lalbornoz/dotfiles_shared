#
# Common platform-independent subroutines
#

#
# curl
#
if _shinit_which curl; then
	paste0x0() { curl -F"file=@${*}" https://0x0.st; };
fi;

#
# diff
#
if _shinit_which diff; then
	mdiff() { for _fname in "$@"; do diff -Nru "${_fname}.orig" "${_fname}"; done };
fi;

#
# fzf
#
if _shinit_which fzf; then
	rfzf() { local _cmd="${1}" _pname="$(fzf)"; shift; "${_cmd}" "${@}" "${_pname}"; };
fi;

#
# gs
#
if _shinit_which gs; then
	fixpdf() { gs -dSAFER -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -sOutputFile="${2}" "${1}"; };
	fixpdf2() { gs -dSAFER -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dCompatibilityLevel=1.3 -dPDFSETTINGS=/ebook -sOutputFile="${2}" "${1}"; };
fi;

#
# keepassxc
#
if _shinit_which keepassxc awk date sha256sum; then
	kdbx_update() {
		local _hname="${1}" _choice="" _fname_dst="" _fname_src="";
		for _fname_src in "${_hname}"\ \([0-9-]*,\ [0-9a-f]*\).kdbx; do
			if [ ! -e "${_fname_src}" ]; then
				continue;
			fi;

			_fname_dst="${_hname} ($(date +%Y-%m-%d), $(sha256sum "${_fname_src}" | awk '{print $1}')).kdbx";
			if [ "${_fname_dst}" != "${_fname_src}" ]; then
				printf "Rename from/to:\n%s\n%s\n(y|N) " "${_fname_src}" "${_fname_dst}";
				read _choice;
				case "${_choice}" in [yY]) mv "${_fname_src}" "${_fname_dst}"; ;; esac;
			fi;

			printf "Symlink target/link name:\n%s\n%s\n(y|N) " "${_fname_dst}" "${_hname}.kdbx";
			read _choice;
			case "${_choice}" in [yY]) ln -fs "${_fname_dst}" "${_hname}.kdbx"; ;; esac;
		done;
	};
fi;

#
# openssl
#
if _shinit_which openssl awk; then
	randpw() {
		local _rp_len="${1:-22}";
		openssl rand -base64 "${_rp_len}"				|\
		awk "{lines = lines \$0} END {print substr(lines, 0, ${_rp_len})}";
	};
fi;

#
# pdf2ps
#
if _shinit_which pdf2ps; then
	shrinkpdf() {
		local _fname="${1:?usage: shrinkpdf fname.pdf}";
		pdf2ps -dLanguageLevel=3 "${_fname}" "${_fname}.ps" || return "${?}";
		ps2pdf -dPDFSETTINGS=/ebook "${_fname}.ps" "${_fname%.pdf}.new.pdf" || return "${?}";
		rm -f "${_fname}.ps";
	};
fi;

#
# ps
#
if ! _shinit_which ps2 && _shinit_which grep; then
	ps2() { command ps "${@}" | command grep -v "\[[^]]*\]\$"; };
fi;

#
# sed, shuf, tr, /usr/share/dict/words
#
if _shinit_which sed shuf tr && [ -e /usr/share/dict/words ]; then
	randwords() {
		local _nwords="${1:-5}" _word="" _words="";
		while [ "${_nwords}" -gt 0 ]; do
			_word="$(shuf -n 1 /usr/share/dict/words | sed "s/'//g" | tr A-Z a-z)";
			_words="${_words:+${_words}}${_word}";
			: $((_nwords-=1));
		done;
		printf "%s\n" "${_words}";
};
fi;

#
# tac
#
if ! _shinit_which tac && _shinit_which sed; then
	tac() { sed -n '1!G;$p;h;'; };
fi;

#
# vnstat
#
if _shinit_which vnstat; then
	vnstat_median() {
		local	_period="${1}"					\
			_max_rx="" _max_total="" _max_tx=""		\
			_median_rx="" _median_total="" _median_tx=""	\
			_min_rx="" _min_total="" _min_tx="";

		set -- $(
			export LC_ALL=C;
			vnstat "${_period}"					|\
			sort -k2 -n -r						|\
			awk '
				function auc(_data_count, _data_list) {
					_data_auc = ((_data_count > 1) ? 0	\
						: ((_data_count > 0) ? _data_list[0] : 0));

					for (_data_idx = 0; (_data_idx + 1) < _data_count; _data_idx++) {
						_data0 = _data_list[_data_idx + 0];
						_data1 = _data_list[_data_idx + 1];

						if (_data1 > _data0) {
							_data_auc += 0.5 * (_data0 + _data1);
						} else {
							_data_auc1 = log(_data0) - log(_data1);
							_data_auc += (_data0 - _data1) / ((_data_auc1 > 0) ? _data_auc1 : 1);
						}
					};

					return _data_auc / _data_count;
				}

				function max(_data_count, _data_list) {
					_max = 0;
					for (_data_idx = 0; _data_idx < _data_count; _data_idx++) {
						if (_data_list[_data_idx] > _max) {
							_max = _data_list[_data_idx];
						};
					};
					return _max;
				}

				function min(_data_count, _data_list) {
					_min = -1;
					for (_data_idx = 0; _data_idx < _data_count; _data_idx++) {
						if ((_min == -1) || (_data_list[_data_idx] < _min)) {
							_min = _data_list[_data_idx];
						};
					};
					return _min;
				}

				function parse_number(_number, _unit) {
					if (_unit == "KiB") {return _number / 1024 / 1024}
					else if (_unit == "MiB") {return _number / 1024}
					else if (_unit == "TiB") {return _number * 1024}
					else if (_unit == "PiB") {return _number * 1024 * 1024}
					else {return _number}
				}

				BEGIN {
					count = 0;
				}

				$1 ~ /^[0-9.-]+$/ {
					rx[count] = parse_number($2, $3);
					tx[count] = parse_number($5, $6);
					total[count] = parse_number($8, $9);
					count++;
				}

				END {
					print auc(count, rx) " " auc(count, tx) " " auc(count, total);
					print max(count, rx) " " max(count, tx) " " max(count, total);
					print min(count, rx) " " min(count, tx) " " min(count, total);
				}');

		_median_rx="${1}"; _median_tx="${2}"; _median_total="${3}";
		_max_rx="${4}"; _max_tx="${5}"; _max_total="${6}";
		_min_rx="${7}"; _min_tx="${8}"; _min_total="${9}";

		vnstat "${_period}";
		printf	"%14.14s %13.13s | %11.11s | %11.11s |\n"	\
			"median"					\
			"$(printf "%.2f GiB" "${_median_rx}")"		\
			"$(printf "%.2f GiB" "${_median_tx}")"		\
			"$(printf "%.2f GiB" "${_median_total}")";
		printf	"%14.14s %13.13s | %11.11s | %11.11s |\n"	\
			"maximum"					\
			"$(printf "%.2f GiB" "${_max_rx}")"		\
			"$(printf "%.2f GiB" "${_max_tx}")"		\
			"$(printf "%.2f GiB" "${_max_total}")";
		printf	"%14.14s %13.13s | %11.11s | %11.11s |\n"	\
			"minimum"					\
			"$(printf "%.2f GiB" "${_min_rx}")"		\
			"$(printf "%.2f GiB" "${_min_tx}")"		\
			"$(printf "%.2f GiB" "${_min_total}")";
	};
fi;

#
# whois
#
if _shinit_which whois && [ "${_shinit_SNAME%BSD}" = "${_shinit_SNAME}" ]; then
	whois() {
		if [ "x${1}" = "x-m" ]; then
			shift; command whois -h whois.radb.net "$@";
		else
			command whois "$@";
		fi;
	};
fi;

